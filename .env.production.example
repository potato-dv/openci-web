# Copy to .env.production and populate with values from the deployment secret store.
# Use URL-safe passwords because these values are embedded in service URLs.
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=lax
POSTGRES_PASSWORD=CHANGE_ME_url_safe_password
REDIS_PASSWORD=CHANGE_ME_url_safe_password
NOMINATIM_PASSWORD=CHANGE_ME_url_safe_password
NOMINATIM_PBF_URL=https://download.geofabrik.de/asia/philippines-latest.osm.pbf
NOMINATIM_IMPORT_THREADS=4
PUBLIC_WEB_ORIGIN=https://openci.example.gov.ph
PUBLIC_API_URL=https://api.openci.example.gov.ph
PLANNING_ENABLED=false

# Replace mutable tags with reviewed immutable image digests before production.
POSTGRES_IMAGE=docker.io/library/postgres:17
REDIS_IMAGE=docker.io/library/redis:7-alpine
PYTHON_IMAGE=docker.io/library/python:3.14-slim
NODE_IMAGE=docker.io/library/node:22-alpine
NGINX_IMAGE=docker.io/library/nginx:alpine

OSRM_DATA_DIR=./infrastructure/geospatial/osrm-data
OSRM_DATASET_VERSION=philippines-YYYY-MM-DD
API_WORKERS=4
CELERY_WORKER_CONCURRENCY=2
PLANNING_MAX_LOCATIONS=80
API_MEMORY_LIMIT=1g
API_CPUS=2.0
CELERY_WORKER_MEMORY_LIMIT=2g
CELERY_WORKER_CPUS=2.0
NOMINATIM_MEMORY_LIMIT=32g
NOMINATIM_CPUS=8.0
OSRM_MEMORY_LIMIT=16g
OSRM_CPUS=8.0
VROOM_MEMORY_LIMIT=1g
VROOM_CPUS=2.0

# Optional map provider override; blank uses the OSM standard raster layer.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
