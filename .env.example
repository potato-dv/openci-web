JWT_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
NOMINATIM_PASSWORD=replace-with-a-long-random-password
NOMINATIM_PBF_URL=https://download.geofabrik.de/asia/philippines-latest.osm.pbf
NOMINATIM_IMPORT_THREADS=4
OSRM_DATASET_VERSION=philippines-YYYY-MM-DD
OSRM_DATA_DIR=./infrastructure/geospatial/osrm-data
GEOSPATIAL_HTTP_TIMEOUT_SECONDS=15
PLANNING_MAX_LOCATIONS=80
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MEMORY_LIMIT=2g
CELERY_WORKER_CPUS=2.0
NOMINATIM_MEMORY_LIMIT=32g
NOMINATIM_CPUS=8.0
OSRM_MEMORY_LIMIT=16g
OSRM_CPUS=8.0
VROOM_MEMORY_LIMIT=1g
VROOM_CPUS=2.0

# Optional map provider override; blank uses the OSM standard raster layer.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
